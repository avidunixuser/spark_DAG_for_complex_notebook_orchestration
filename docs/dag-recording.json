{
  "schema_version": 1,
  "dag_id": "receiving_dag",
  "dag_version": "2.0",
  "code_fingerprint": "ebd94602e856bdaa9e647395bf5ec24c7c1e5b6895aa15fe79bbed38ac781af5",
  "configuration_fingerprint": "68a9a3f507b8208836baf055a2b70e88409585bb8e22cd6b1ef0ee82c958c485",
  "provenance": "Recorded local reference runs with injected faults, not live cloud telemetry.",
  "timing": "Audit sequence order is preserved. Playback uses fixed presentation intervals, not wall-clock durations.",
  "nodes": [
    {
      "id": "extract_shipments",
      "description": "Read a bounded canonical XML shipment-file set and preserve shipment-line business keys.",
      "dependencies": [],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "extract_products",
      "description": "Read canonical XML product catalog files in parallel with shipment ingestion.",
      "dependencies": [],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "validate_shipments",
      "description": "Fan-in; validate positive quantities, shipment-line keys, SKU and unit-of-measure; quarantine invalid lines.",
      "dependencies": [
        "extract_shipments",
        "extract_products"
      ],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "quality_gate",
      "description": "Enforce reject and accepted-row thresholds without dropping rejected records.",
      "dependencies": [
        "validate_shipments"
      ],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "plan_receipts",
      "description": "Aggregate accepted units by warehouse, SKU and unit-of-measure into an immutable receiving plan.",
      "dependencies": [
        "quality_gate"
      ],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "request_receipts",
      "description": "Commit one deduplicated inventory-receipt intent; do not post inventory to a WMS.",
      "dependencies": [
        "plan_receipts"
      ],
      "trigger": {
        "type": "all_success",
        "condition": {
          "parameter": "enabled",
          "equals": true
        }
      }
    },
    {
      "id": "notify_failure",
      "description": "Record a failure notification intent after all main-path nodes are terminal.",
      "dependencies": [
        "extract_shipments",
        "extract_products",
        "validate_shipments",
        "quality_gate",
        "plan_receipts",
        "request_receipts"
      ],
      "trigger": {
        "type": "any_failed"
      }
    },
    {
      "id": "notify_timeout",
      "description": "Record a timeout notice; never automatically unlock uncertain workers.",
      "dependencies": [
        "extract_shipments",
        "extract_products",
        "validate_shipments",
        "quality_gate",
        "plan_receipts",
        "request_receipts"
      ],
      "trigger": {
        "type": "any_timed_out"
      }
    },
    {
      "id": "cleanup",
      "description": "Record end-of-run cleanup bookkeeping; do not delete checkpoints or shared data.",
      "dependencies": [
        "request_receipts",
        "notify_failure",
        "notify_timeout"
      ],
      "trigger": {
        "type": "all_done"
      }
    }
  ],
