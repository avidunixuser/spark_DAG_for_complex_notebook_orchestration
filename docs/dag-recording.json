{
  "schema_version": 1,
  "dag_id": "sales_dag",
  "dag_version": "1.0",
  "code_fingerprint": "bbefb79240d89c1abeb19230ec8af96cea991b84e2277cf4b0f6842f07a8ccfe",
  "configuration_fingerprint": "ab09449078ad3b710b98e7141a60d42557c4096beca05fc29d9da264f05e2c4c",
  "provenance": "Recorded local reference runs with injected faults, not live cloud telemetry.",
  "timing": "Audit sequence order is preserved. Playback uses fixed presentation intervals, not wall-clock durations.",
  "nodes": [
    {
      "id": "extract_orders",
      "description": "Read an immutable landed order snapshot; do not extract with JDBC.",
      "dependencies": [],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "extract_customers",
      "description": "Read the customer dimension snapshot in parallel with orders.",
      "dependencies": [],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "transform_orders",
      "description": "Fan-in; validate integer cents and keys, deduplicate exact rows, join the dimension, quarantine rejects.",
      "dependencies": [
        "extract_orders",
        "extract_customers"
      ],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "quality_gate",
      "description": "Enforce reject and accepted-row thresholds without dropping rejected records.",
      "dependencies": [
        "transform_orders"
      ],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "publish_report",
      "description": "Aggregate exact integer cents by region and publish an immutable report version.",
      "dependencies": [
        "quality_gate"
      ],
      "trigger": {
        "type": "all_success"
      }
    },
    {
      "id": "deliver_report",
      "description": "Commit one deduplicated delivery intent, not an actual external delivery.",
      "dependencies": [
        "publish_report"
      ],
      "trigger": {
        "type": "all_success",
        "condition": {
          "parameter": "enabled",
          "equals": true
        }
      }
    },
    {
      "id": "notify_failure",
      "description": "Record a failure notification intent after all main-path nodes are terminal.",
      "dependencies": [
        "extract_orders",
        "extract_customers",
        "transform_orders",
        "quality_gate",
        "publish_report",
        "deliver_report"
      ],
      "trigger": {
        "type": "any_failed"
      }
    },
    {
      "id": "notify_timeout",
      "description": "Record a timeout notice; never automatically unlock uncertain workers.",
      "dependencies": [
        "extract_orders",
        "extract_customers",
        "transform_orders",
        "quality_gate",
        "publish_report",
        "deliver_report"
      ],
      "trigger": {
        "type": "any_timed_out"
      }
    },
    {
      "id": "cleanup",
      "description": "Record end-of-run cleanup bookkeeping; do not delete checkpoints or shared data.",
      "dependencies": [
        "deliver_report",
        "notify_failure",
        "notify_timeout"
      ],
      "trigger": {
        "type": "all_done"
      }
    }
  ],
