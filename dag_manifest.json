{
  "schema_version": "1.0",
  "reference_only": true,
  "dag": {
    "id": "receiving_dag",
    "version": "2.0",
    "compatible_versions": [],
    "entry_nodes": [
      "extract_shipments",
      "extract_products"
    ]
  },
  "topological_plan": [
    "extract_products",
    "extract_shipments",
    "validate_shipments",
    "quality_gate",
    "plan_receipts",
    "request_receipts",
    "notify_failure",
    "notify_timeout",
    "cleanup"
  ],
  "nodes": [
    {
      "id": "extract_shipments",
      "notebook": "extract_shipments",
      "original_stage": "SAMPLE::CanonicalShipmentBatches",
      "description": "Read a bounded canonical XML shipment-file set and preserve shipment-line business keys.",
      "dependencies": [],
      "trigger": {
        "type": "all_success"
      },
      "parameters": {
        "source": {
          "$config": "sources.shipments"
        }
      },
      "expected_outputs": [
        "shipments"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 1,
        "delay_seconds": 0.1,
        "backoff": 2,
        "max_delay_seconds": 2,
        "categories": [
          "INFRASTRUCTURE",
          "RETRYABLE_APPLICATION",
          "TIMEOUT"
        ]
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "overwrite",
        "commit_boundary": "Immutable attempt artifact",
        "partial_write": "Unreferenced staging data",
        "recovery": "Read the same source snapshot",
        "duplicate_prevention": "Downstream uses only checkpoint references",
        "output_validation": "Content digest and row count"
      },
      "checkpoint": {
        "name": "shipments_landed",
        "required": true
      },
      "failure_classification": "DATA_QUALITY",
      "critical": true,
      "concurrency_group": "extract",
      "resources": {
        "source_reads": 1
      }
    },
    {
      "id": "extract_products",
      "notebook": "extract_products",
      "original_stage": "SAMPLE::CanonicalProductCatalog",
      "description": "Read canonical XML product catalog files in parallel with shipment ingestion.",
      "dependencies": [],
      "trigger": {
        "type": "all_success"
      },
      "parameters": {
        "source": {
          "$config": "sources.products"
        }
      },
      "expected_outputs": [
        "products"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 1,
        "delay_seconds": 0.1,
        "backoff": 2,
        "max_delay_seconds": 2,
        "categories": [
          "INFRASTRUCTURE",
          "RETRYABLE_APPLICATION",
          "TIMEOUT"
        ]
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "overwrite",
        "commit_boundary": "Immutable attempt artifact",
        "partial_write": "Unreferenced staging data",
        "recovery": "Read the same source snapshot",
        "duplicate_prevention": "Downstream uses only checkpoint references",
        "output_validation": "Content digest and row count"
      },
      "checkpoint": {
        "name": "products_landed",
        "required": true
      },
      "failure_classification": "DATA_QUALITY",
      "critical": true,
      "concurrency_group": "extract",
      "resources": {
        "source_reads": 1
      }
    },
    {
      "id": "validate_shipments",
      "notebook": "validate_shipments",
      "original_stage": "SAMPLE::ValidateReceivingLines",
      "description": "Fan-in; validate positive quantities, shipment-line keys, SKU and unit-of-measure; quarantine invalid lines.",
      "dependencies": [
        "extract_shipments",
        "extract_products"
      ],
      "trigger": {
        "type": "all_success"
      },
      "parameters": {
        "rules": {
          "$config": "data_quality"
        }
      },
      "expected_outputs": [
        "accepted",
        "rejects"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 1,
        "delay_seconds": 0.1,
        "backoff": 2,
        "max_delay_seconds": 2,
        "categories": [
          "INFRASTRUCTURE",
          "RETRYABLE_APPLICATION",
          "TIMEOUT"
        ]
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "overwrite",
        "commit_boundary": "Both artifacts validated before checkpoint",
        "partial_write": "One artifact may exist but is not advertised",
        "recovery": "Recompute from immutable upstream artifacts",
        "duplicate_prevention": "Reject conflicting keys; collapse identical rows",
        "output_validation": "Digest, count, and key validation"
      },
      "checkpoint": {
        "name": "shipments_validated",
        "required": true
      },
      "failure_classification": "DATA_QUALITY",
      "critical": true,
      "concurrency_group": "compute",
      "resources": {}
    },
    {
      "id": "quality_gate",
      "notebook": "quality_gate",
      "original_stage": "SAMPLE::QualityGate",
      "description": "Enforce reject and accepted-row thresholds without dropping rejected records.",
      "dependencies": [
        "validate_shipments"
      ],
      "trigger": {
        "type": "all_success"
      },
      "parameters": {
        "rules": {
          "$config": "data_quality"
        }
      },
      "expected_outputs": [
        "accepted"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 0,
        "delay_seconds": 0,
        "backoff": 1,
        "max_delay_seconds": 0,
        "categories": []
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "natural",
        "commit_boundary": "Validated reference to upstream committed data",
        "partial_write": "No write",
        "recovery": "Re-evaluate the gate",
        "duplicate_prevention": "Read-only validation",
        "output_validation": "Thresholds, digest, and count"
      },
      "checkpoint": {
        "name": "quality_approved",
        "required": true
      },
      "failure_classification": "DATA_QUALITY",
      "critical": true,
      "concurrency_group": "compute",
      "resources": {}
    },
    {
      "id": "plan_receipts",
      "notebook": "plan_receipts",
      "original_stage": "SAMPLE::WarehouseReceivingPlan",
      "description": "Aggregate accepted units by warehouse, SKU and unit-of-measure into an immutable receiving plan.",
      "dependencies": [
        "quality_gate"
      ],
      "trigger": {
        "type": "all_success"
      },
      "parameters": {
        "target": {
          "$config": "targets.receiving_plan"
        }
      },
      "expected_outputs": [
        "receiving_plan"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 1,
        "delay_seconds": 0.1,
        "backoff": 2,
        "max_delay_seconds": 2,
        "categories": [
          "INFRASTRUCTURE",
          "RETRYABLE_APPLICATION",
          "TIMEOUT"
        ]
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "overwrite",
        "commit_boundary": "Immutable receiving plan and control checkpoint",
        "partial_write": "Unreferenced attempt artifact",
        "recovery": "Rebuild from approved shipment lines",
        "duplicate_prevention": "One published checkpoint per run/node",
        "output_validation": "Warehouse/SKU/unit totals and content digest"
      },
      "checkpoint": {
        "name": "receiving_plan_committed",
        "required": true
      },
      "failure_classification": "INFRASTRUCTURE",
      "critical": true,
      "concurrency_group": "publish",
      "resources": {
        "target_writes": 1
      }
    },
    {
      "id": "request_receipts",
      "notebook": "request_receipts",
      "original_stage": "SAMPLE::InventoryReceiptOutbox",
      "description": "Commit one deduplicated inventory-receipt intent; do not post inventory to a WMS.",
      "dependencies": [
        "plan_receipts"
      ],
      "trigger": {
        "type": "all_success",
        "condition": {
          "parameter": "enabled",
          "equals": true
        }
      },
      "parameters": {
        "enabled": {
          "$config": "targets.inventory_receipts.enabled"
        }
      },
      "expected_outputs": [
        "receipt"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 1,
        "delay_seconds": 0.1,
        "backoff": 2,
        "max_delay_seconds": 2,
        "categories": [
          "INFRASTRUCTURE",
          "RETRYABLE_APPLICATION",
          "TIMEOUT"
        ]
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "deduplicate",
        "commit_boundary": "Transactional outbox event",
        "partial_write": "Intent may commit before the node checkpoint",
        "recovery": "Reuse the same business-key intent",
        "duplicate_prevention": "Stable key plus payload digest under the control-store lock",
        "output_validation": "Validate durable receipt and payload digest"
      },
      "checkpoint": {
        "name": "receipt_requested",
        "required": true
      },
      "failure_classification": "RETRYABLE_APPLICATION",
      "critical": true,
      "concurrency_group": "publish",
      "resources": {
        "target_writes": 1
      }
    },
    {
      "id": "notify_failure",
      "notebook": "notify_failure",
      "original_stage": "SAMPLE::FailureTrigger",
      "description": "Record a failure notification intent after all main-path nodes are terminal.",
      "dependencies": [
        "extract_shipments",
        "extract_products",
        "validate_shipments",
        "quality_gate",
        "plan_receipts",
        "request_receipts"
      ],
      "trigger": {
        "type": "any_failed"
      },
      "parameters": {
        "kind": "failure"
      },
      "expected_outputs": [
        "notice"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 0,
        "delay_seconds": 0,
        "backoff": 1,
        "max_delay_seconds": 0,
        "categories": []
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "overwrite",
        "commit_boundary": "Immutable control notice",
        "partial_write": "Unreferenced attempt artifact",
        "recovery": "Recreate the notice",
        "duplicate_prevention": "Versioned notice reference",
        "output_validation": "Digest and count"
      },
      "checkpoint": {
        "name": "failure_noted",
        "required": true
      },
      "failure_classification": "INFRASTRUCTURE",
      "critical": false,
      "concurrency_group": "control",
      "resources": {}
    },
    {
      "id": "notify_timeout",
      "notebook": "notify_timeout",
      "original_stage": "SAMPLE::TimeoutTrigger",
      "description": "Record a timeout notice; never automatically unlock uncertain workers.",
      "dependencies": [
        "extract_shipments",
        "extract_products",
        "validate_shipments",
        "quality_gate",
        "plan_receipts",
        "request_receipts"
      ],
      "trigger": {
        "type": "any_timed_out"
      },
      "parameters": {
        "kind": "timeout"
      },
      "expected_outputs": [
        "notice"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 0,
        "delay_seconds": 0,
        "backoff": 1,
        "max_delay_seconds": 0,
        "categories": []
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "overwrite",
        "commit_boundary": "Immutable control notice",
        "partial_write": "Unreferenced attempt artifact",
        "recovery": "Recreate the notice",
        "duplicate_prevention": "Versioned notice reference",
        "output_validation": "Digest and count"
      },
      "checkpoint": {
        "name": "timeout_noted",
        "required": true
      },
      "failure_classification": "TIMEOUT",
      "critical": false,
      "concurrency_group": "control",
      "resources": {}
    },
    {
      "id": "cleanup",
      "notebook": "cleanup",
      "original_stage": "SAMPLE::CompletionTrigger",
      "description": "Record end-of-run cleanup bookkeeping; do not delete checkpoints or shared data.",
      "dependencies": [
        "request_receipts",
        "notify_failure",
        "notify_timeout"
      ],
      "trigger": {
        "type": "all_done"
      },
      "parameters": {},
      "expected_outputs": [
        "receipt"
      ],
      "timeout_seconds": 30,
      "retry": {
        "max_retries": 1,
        "delay_seconds": 0.1,
        "backoff": 2,
        "max_delay_seconds": 2,
        "categories": [
          "INFRASTRUCTURE",
          "RETRYABLE_APPLICATION",
          "TIMEOUT"
        ]
      },
      "restart": {
        "eligible": true,
        "policy": "reuse_valid"
      },
      "idempotency": {
        "strategy": "overwrite",
        "commit_boundary": "Immutable cleanup receipt",
        "partial_write": "Unreferenced receipt",
        "recovery": "Recreate bookkeeping",
        "duplicate_prevention": "No external destructive side effect",
        "output_validation": "Digest and count"
      },
      "checkpoint": {
        "name": "cleanup_recorded",
        "required": true
      },
      "failure_classification": "INFRASTRUCTURE",
      "critical": true,
      "concurrency_group": "control",
      "resources": {}
    }
  ]
}
